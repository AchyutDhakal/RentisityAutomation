pipeline {
    agent any

    environment{
        LANDLORD_EMAIL = credentials('landlord_email')
        LANDLORD_PASSWORD = credentials('landlord_password')
        ADMIN_EMAIL = credentials('admin_email')
        ADMIN_PASSWORD = credentials('admin_password')
    }

    stages {
        stage('Install Dependencies') {
            steps {
                sh 'pip3 install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'python3 -m pytest'
            }
        }
    }
}